<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False" style="Assets/Resources/UI/ShipDetailPanel.uss">
    <Style src="project://database/Assets/Resources/UI/ShipDetailPanel.uss?fileID=7433441132597879392&amp;guid=b192e55ff0db9104ab631afda5fc0395&amp;type=3#ShipDetailPanel" />
    <engine:VisualElement name="root" style="position: absolute; align-content: auto; align-items: flex-start; flex-direction: row; justify-content: flex-start; top: 0; width: 100%; height: 100%; right: 0;">
        <engine:VisualElement name="rectContainer" style="flex-grow: 1; width: 0; max-width: 0; min-width: 0; max-height: 0; min-height: 0; height: 0; position: absolute; top: 0; left: 0;" />
        <engine:VisualElement name="waypointsContainer" style="flex-grow: 1;" />
        <engine:VisualElement name="UIPanel" style="width: 420px; flex-direction: column; padding: 10px; min-width: 20px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(55, 55, 55); border-right-color: rgb(55, 55, 55); border-top-color: rgb(55, 55, 55); border-bottom-color: rgb(55, 55, 55); height: 200px;">
            <engine:VisualElement style="flex-direction: row; justify-content: space-between; height: auto;">
                <engine:VisualElement style="flex-direction: column; flex-grow: 1; justify-content: flex-start; height: auto; width: auto; align-content: flex-start; align-self: auto; align-items: stretch;">
                    <engine:VisualElement style="flex-grow: 1; height: auto; max-height: none;">
                        <engine:VisualElement style="flex-grow: 1; flex-direction: row; max-height: 20px; justify-content: space-between; width: 180px;">
                            <engine:VisualElement style="flex-grow: 1; flex-direction: row;">
                                <engine:VisualElement name="ShipTypeIcon" class="ship-type-icon" style="width: 20px; height: 20px; max-width: 20px; max-height: 20px; min-height: 20px; -unity-text-align: middle-left; justify-content: center; align-self: auto; min-width: 20px; background-size: contain; -unity-background-scale-mode: scale-to-fit; background-image: resource(&apos;Images/Ship/Ship&apos;);" />
                                <engine:Label text="Name" name="lblName" class="ship-name-label" />
                            </engine:VisualElement>
                            <engine:Label name="lblLevel" text="等級: 1" class="ship-level-label" />
                        </engine:VisualElement>
                        <engine:VisualElement name="expBarContainer" class="progress-bar-container">
                            <engine:VisualElement name="expBar" class="progress-bar" style="background-color: rgb(162, 214, 80);" />
                            <engine:Label name="lblExperience" text="0/10" class="progress-label" />
                        </engine:VisualElement>
                        <engine:VisualElement name="healthBarContainer" class="progress-bar-container">
                            <engine:VisualElement name="healthBar" class="progress-bar" style="background-color: rgb(255, 0, 0);" />
                            <engine:Label name="lblHealth" text="100/100" class="progress-label" />
                        </engine:VisualElement>
                        <engine:VisualElement name="fuelBarContainer" class="progress-bar-container">
                            <engine:VisualElement name="fuelBar" class="progress-bar" style="background-color: rgb(70, 75, 70);" />
                            <engine:Label name="lblFuel" text="100/100" class="progress-label" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement style="flex-direction: row; flex-wrap: wrap; margin-top: 10px; top: auto; align-items: stretch;">
                        <engine:Button name="btnCancelFollow" text="取消跟隨" class="cancel-follow-btn" style="width: 30px; margin-right: 0; height: 30px; margin-top: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                        <engine:Button name="StartDrawButton" text="Start Draw" class="draw-button" style="margin-right: 0; width: 30px; height: 30px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-bottom: 0; margin-left: 0;" />
                        <engine:Button name="btnToggleCombatMode" text="進入戰鬥模式" class="combat-mode-btn" style="width: 30px; margin-right: 0; margin-top: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 30px;" />
                        <engine:Button name="btnFleetCombatMode" text="編輯船隊戰鬥模式" style="width: 150px; display: none; margin-right: 8px;" />
                        <engine:Button name="btnFormFleet" text="形成船隊" class="form-shipline-btn" style="width: 30px; height: 30px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                        <engine:Button name="btnDrawWaypoint" text="繪製航點" class="draw-waypoint-btn" style="width: 30px; margin-right: 0; height: 30px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-bottom: 0; margin-left: 0;" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="VisualElement" style="flex-direction: column; margin-right: 0; margin-top: 0; margin-bottom: 0; margin-left: 0; align-items: stretch; align-content: flex-start; max-height: none;">
                    <engine:Label text="速度" name="Label" class="title" />
                    <engine:Label text="Full" name="lblSpeedFrontFull" />
                    <engine:Label text="3/4" name="lblSpeedFrontThreeQuarters" />
                    <engine:Label text="1/2" name="lblSpeedFrontHalf" />
                    <engine:Label text="1/4" name="lblSpeedFrontQuarter" />
                    <engine:Label text="Stop" name="lblSpeedStop" />
                    <engine:Label text="Full" name="lblSpeedBackFull" />
                </engine:VisualElement>
                <engine:VisualElement style="flex-direction: column; margin-right: 0; margin-top: 0; margin-bottom: 0; margin-left: 0;">
                    <engine:Label text="旋轉" class="title" />
                    <engine:Label text="Full" name="lblRotationLeftFull" />
                    <engine:Label text="1/2" name="lblRotationLeftHalf" />
                    <engine:Label text="Stop" name="lblRotationStop" />
                    <engine:Label text="1/2" name="lblRotationRightHalf" />
                    <engine:Label text="Full" name="lblRotationRightFull" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:Button name="btnCloseUI" text="X" class="close-ui-btn" style="margin-right: 0; position: absolute; top: 0; right: 0; translate: 50% -50%; margin-top: 0; margin-bottom: 0; margin-left: 0; width: 25px; align-self: auto; -unity-text-align: middle-center; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-text-outline-color: rgba(207, 3, 3, 0.75); -unity-text-outline-width: 3px; color: rgb(209, 191, 191); height: 25px;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
