.game-data-create-panel {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    width: 320px;
    background-color: rgba(34,34,34,0.8); /* 修正顏色格式 */
    border-radius: 12px;
}

.title-label {
    font-size: 20px;
    margin-bottom: 16px;
    color: #fff;
}

.input-field {
    width: 100%;
    margin-bottom: 16px;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.main-button {
    flex-grow: 1;
    font-size: 16px;
    padding: 8px 0;
    margin-right: 12px;
}

.main-button:last-child {
    margin-right: 0;
}
