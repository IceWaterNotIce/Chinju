.menu-button-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0px;
    margin-top: 12px;
}

.game-icon {
    width: 128px;
    height: 128px;
    margin-bottom: 16px;
}

.game-version {
    font-size: 16px;
    color: white;
    margin-bottom: 24px;
}

.menu-button {
    margin-bottom: 10px;
}
